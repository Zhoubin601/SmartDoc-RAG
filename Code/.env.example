# ==============================================================================
# SmartDoc-RAG 环境变量配置模板
# 使用前请复制此文件为 .env，并根据您的实际 API 服务商填入配置信息
# ==============================================================================

# 1. 在线大语言模型配置 (OpenAI 兼容接口)
# 支持 DeepSeek / 通义千问(DashScope) / OpenAI / 硅基流动 / 智谱AI / 月之暗面 等
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash
TEMPERATURE=0.3

# 2. Embedding 向量模型配置
# 如果使用 OpenAI / 兼容的 Embedding 接口，可填入对应配置
# 默认在界面选择本地 TF-IDF；在线模式必须单独提供可用配置，错误时不会自动回退
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# 3. 知识库与切分参数
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
